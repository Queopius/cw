# CW 0.14 local-agent staging profile. This file contains no credentials.
CW_REMOTE_GATEWAY_URL=https://staging-mcp.cwcli.dev

# Keep device credentials and opaque project mappings outside the repository.
CW_REMOTE_CREDENTIALS_PATH=/absolute/private/path/cw-staging-device.json
CW_REMOTE_STATE_PATH=/absolute/private/path/cw-staging-projects.json

# Authorize one explicit initialized CW project and its narrow containing root.
CW_REMOTE_PROJECT_PATH=/absolute/path/to/authorized-cw-project
CW_REMOTE_ALLOWED_ROOT=/absolute/path/to/authorized-cw-project
