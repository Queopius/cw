{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "version", "channel", "published_at",
    "minimum_project_schema", "maximum_project_schema", "artifacts",
    "release_notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "channel": {"enum": ["stable", "beta", "dev"]},
    "published_at": {"type": "string", "format": "date-time"},
    "minimum_project_schema": {"type": "integer", "minimum": 1},
    "maximum_project_schema": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "arch", "url", "sha256", "filename"],
        "properties": {
          "platform": {"type": "string"},
          "arch": {"type": "string"},
          "url": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
          "filename": {"type": "string"}
        }
      }
    },
    "release_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "url"],
      "properties": {
        "summary": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "signature": {
      "type": ["object", "null"],
      "properties": {
        "extensions": {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "version", "asset", "core_compatibility", "provenance"],
              "properties": {
                "name": {"const": "cw"},
                "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
                "asset": {
                  "type": "object", "additionalProperties": false,
                  "required": ["filename", "sha256", "size"],
                  "properties": {
                    "filename": {"type": "string", "pattern": "^cw-plugin-[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$"},
                    "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
                    "size": {"type": "integer", "minimum": 1}
                  }
                },
                "core_compatibility": {
                  "type": "object", "additionalProperties": false,
                  "required": ["minimum", "maximum_exclusive"],
                  "properties": {"minimum": {"type": "string"}, "maximum_exclusive": {"type": "string"}}
                },
                "provenance": {
                  "type": "object", "additionalProperties": false,
                  "required": ["source_commit", "builder"],
                  "properties": {
                    "source_commit": {"type": "string", "minLength": 1},
                    "builder": {"const": "scripts/build_plugin_candidate.py"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
