{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwcli.dev/schemas/cw.output.v1.json",
  "title": "CW output envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "command", "status", "changed", "truncation"],
  "properties": {
    "schema": {"const": "cw.output.v1"},
    "ok": {"type": "boolean"},
    "command": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["success", "noop", "error", "authorization_required", "blocked", "partial", "cancelled"]
    },
    "changed": {"type": "boolean"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string"},
        "pr": {"type": "integer", "minimum": 1},
        "head_branch": {"type": "string"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_branch": {"type": "string"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evidence_schema": {"type": "integer", "minimum": 1},
        "generation": {"type": ["string", "integer"]},
        "authorization_state": {"type": "string"},
        "final_state": {"type": "string"},
        "next_safe_action": {"type": "string"}
      }
    },
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "hint", "correlation_id"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "hint": {"type": ["string", "null"]},
        "correlation_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "has_more", "next_cursor"],
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"]}
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated", "reason"],
      "properties": {
        "truncated": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    }
  },
  "oneOf": [
    {"required": ["data"], "not": {"required": ["error"]}},
    {"required": ["error"], "not": {"required": ["data"]}}
  ]
}
