{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwcli.dev/schemas/cw.verification-receipt.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema", "receipt_id", "correlation_id", "created_at",
    "workflow_id", "workflow_sha256", "state_sha256_before", "plan_revision_id",
    "phase_id", "semantic_attempt", "artifact_identities", "review_paths",
    "completion_contract_sha256", "commands", "preflight", "runtime", "result",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {"const": "cw.verification-receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^vr-[0-9a-f]{64}$"},
    "correlation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "workflow_id": {"type": "string", "minLength": 1},
    "workflow_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state_sha256_before": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_revision_id": {"type": ["string", "null"]},
    "phase_id": {"type": "string", "minLength": 1},
    "semantic_attempt": {"type": "integer", "minimum": 1},
    "artifact_identities": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "review_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "completion_contract_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index", "command", "argv", "cwd", "timeout_seconds", "exit_code",
          "duration_ms", "stdout_sha256", "stderr_sha256"
        ],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "command": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cwd": {"const": "."},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "exit_code": {"type": "integer"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "stdout_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"const": "PASSED"},
        "checks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "private", "cache_isolated", "environment"],
      "properties": {
        "id": {"type": "string", "pattern": "^vrt-[0-9a-f]{64}$"},
        "private": {"const": true},
        "cache_isolated": {"const": true},
        "environment": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "result": {"const": "PASSED"},
    "receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
