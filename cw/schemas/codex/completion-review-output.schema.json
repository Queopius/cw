{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision", "contract_results", "system_findings", "missing_evidence",
    "extension_recommendation", "summary"
  ],
  "properties": {
    "decision": {"enum": ["SATISFIED", "EXTENSION_REQUIRED", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1},
    "contract_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["VERIFIED", "INFERRED", "NOT_VERIFIED", "MISSING"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "system_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "summary", "evidence", "requirement_ids"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocking", "advisory"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extension_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "requirement_ids"],
      "properties": {
        "rationale": {"type": "string"},
        "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
