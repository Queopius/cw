{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "phase", "status", "artifacts", "checks_executed"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "phase": {"type": "string"},
    "status": {"const": "READY_FOR_REVIEW"},
    "artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "checks_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": {"type": "string"},
          "exit_code": {"type": "integer"}
        }
      }
    },
    "verification_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256", "digest", "receipt_id"],
      "properties": {
        "reference": {"type": "string", "pattern": "^\\.cw/verification-receipts/[A-Za-z0-9._-]+\\.json$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "receipt_id": {"type": "string", "pattern": "^vr-[0-9a-f]{64}$"}
      }
    }
  }
}
